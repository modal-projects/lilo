 import asyncio
+import sys
 from types import SimpleNamespace
 
 import pytest
@@ -14,6 +15,24 @@ from lilo.backends.miles_runtime.runtime import (
 from lilo.errors import BackendFailed
 
 
+def test_context_parallel_guard_uses_current_miles_lora_module(monkeypatch):
+    seen = []
+    arguments = SimpleNamespace(
+        validate_multi_lora_args=lambda args: seen.append(args.context_parallel_size)
+    )
+    monkeypatch.setitem(sys.modules, "miles", SimpleNamespace())
+    monkeypatch.setitem(sys.modules, "miles.utils", SimpleNamespace())
+    monkeypatch.setitem(sys.modules, "miles.utils.lora", SimpleNamespace(arguments=arguments))
+    miles_runtime._allow_context_parallel_multi_lora()
+    patched = arguments.validate_multi_lora_args
+    args = SimpleNamespace(context_parallel_size=4)
+    patched(args)
+    assert seen == [1]
+    assert args.context_parallel_size == 4
+    miles_runtime._allow_context_parallel_multi_lora()
+    assert arguments.validate_multi_lora_args is patched
+
+
